{
  "name": "quiver",
  "version": "0.1.0",
  "description": "A library of AI coding assistant skills, written once and transpiled to Claude Code, OpenCode, and GitHub Copilot",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "quiver": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.test.json"
  },
  "keywords": [
    "ai",
    "claude-code",
    "opencode",
    "copilot",
    "skills",
    "prompts",
    "agents"
  ],
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "commander": "^13.1.0",
    "glob": "^11.0.1",
    "gray-matter": "^4.0.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.0"
  },
  "files": [
    "dist",
    "skills",
    "third-party-references",
    "templates"
  ]
}