{
  "name": "quiver",
  "version": "0.1.0",
  "description": "A library of AI coding assistant skills, written once and transpiled to Claude Code, OpenCode, GitHub Copilot, pi, and DeepSeek Harness",
  "type": "module",
  "author": {
    "name": "Noah Clarke",
    "url": "https://github.com/noahwc"
  },
  "homepage": "https://github.com/noahwc/quiver",
  "repository": "https://github.com/noahwc/quiver",
  "bin": {
    "quiver": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "quiver": "node src/cli/index.ts",
    "plugin:sync": "node src/cli/index.ts export --out plugin --subtree --force",
    "test": "node --test \"tests/**/*.test.ts\"",
    "lint": "tsc -p tsconfig.test.json"
  },
  "engines": {
    "node": ">=23.6"
  },
  "keywords": [
    "ai",
    "claude-code",
    "opencode",
    "copilot",
    "pi",
    "deepseek-harness",
    "skills",
    "prompts",
    "agents"
  ],
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "argparse": "^3.0.4",
    "js-yaml": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.8.3"
  },
  "files": [
    "dist",
    "skills",
    "registry.json"
  ]
}
